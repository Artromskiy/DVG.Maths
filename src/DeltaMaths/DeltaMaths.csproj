<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Lowercase names are intentional shader-facing API identifiers. -->
    <!-- Maths and maths are distinct managed/shader facades and must coexist.
         CA1708/CA1724 are suppressed only for this intentional case-only split. -->
    <!-- Public API documentation is maintained separately from generated symbols. -->
    <NoWarn>$(NoWarn);CS8981;CA1708;CA1724;EnableGenerateDocumentationFile</NoWarn>
    <AssemblyName>DeltaMaths</AssemblyName>
    <PackageId>DeltaMaths</PackageId>
    <Version>0.0.9</Version>
    <Authors>Artromskiy</Authors>
    <Description>Portable engine-independent mathematics and GLSL-compatible types for .NET.</Description>
    <PackageTags>mathematics;vectors;matrices;quaternion;glsl;game-development</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaMaths</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">true</EnableAotAnalyzer>
    <RootNamespace>Delta</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE"
          Pack="true"
          PackagePath="LICENSE"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
