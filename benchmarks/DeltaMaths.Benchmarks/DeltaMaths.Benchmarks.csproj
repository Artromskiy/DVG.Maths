<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- BenchmarkDotNet discovers public members by reflection; this executable is not a documented library surface. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>DeltaMaths.Benchmarks</AssemblyName>
    <RootNamespace>Delta.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DeltaMaths/DeltaMaths.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>

</Project>
