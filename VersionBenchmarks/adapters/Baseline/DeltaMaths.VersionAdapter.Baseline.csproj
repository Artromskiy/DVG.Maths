<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DeltaMaths.VersionAdapter.Baseline</AssemblyName>
    <RootNamespace>DeltaMaths.VersionAdapter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Target Name="ValidateBaselineRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BaselineRoot)' == ''" Text="BaselineRoot is required. Pass -p:BaselineRoot=/path/to/baseline/checkout." />
    <Error Condition="!Exists('$(BaselineRoot)/DeltaMaths.csproj')" Text="BaselineRoot does not contain DeltaMaths.csproj: $(BaselineRoot)" />
  </Target>

  <ItemGroup>
    <Compile Include="../DeltaMathsScenario.cs" Link="DeltaMathsScenario.cs" />
    <ProjectReference Include="../../Shared/DeltaMaths.VersionBenchmarks.Shared.csproj" />
    <ProjectReference Include="$(BaselineRoot)/DeltaMaths.csproj"
                      Aliases="mathsRuntime"
                      SetTargetFramework="TargetFramework=netstandard2.1"
                      AdditionalProperties="AssemblyName=DeltaMaths.VersionBaseline" />
  </ItemGroup>

</Project>
